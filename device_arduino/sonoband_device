  lowerClass.toLowerCase();

  if (lowerClass == "critical" || lowerLabel.indexOf("fire") >= 0 || lowerLabel.indexOf("siren") >= 0 || lowerLabel.indexOf("fallen") >= 0) {
    return 3000;
  } 
  else if (lowerClass == "high" || lowerLabel.indexOf("glass") >= 0 || lowerLabel.indexOf("baby") >= 0 || lowerLabel.indexOf("cry") >= 0 || lowerLabel.indexOf("horn") >= 0 || lowerLabel.indexOf("car") >= 0 || lowerLabel.indexOf("bark") >= 0 || lowerLabel.indexOf("dog") >= 0) {
    return 2000;
  } 
  else {
    return 1000;
  }
}

// ================= SUPABASE ALERT UPLOADER =================
void sendAlertToDatabase(String soundType, String alertType, char direction) {
  if (WiFi.status() != WL_CONNECTED) {
    Serial.println("[Supabase] WiFi disconnected. Alert upload skipped.");
    return;
  }

  HTTPClient http;
  http.begin(SUPABASE_ALERTS_ENDPOINT);
  
  // Required Headers for Supabase REST API
  http.addHeader("Content-Type", "application/json");
  http.addHeader("apikey", SUPABASE_KEY);
  http.addHeader("Authorization", String("Bearer ") + SUPABASE_KEY);
  http.addHeader("Prefer", "return=minimal");

  // Create JSON Payload
  #if ARDUINOJSON_VERSION_MAJOR >= 7
    JsonDocument doc;
  #else
    DynamicJsonDocument doc(256);
  #endif

  if (currentLoggedInUser.length() > 0 && currentLoggedInUser != "0") {
    doc["user_id"] = currentLoggedInUser.toInt();
  } else {
    doc["user_id"] = nullptr;
  }
  
  doc["sound_type"] = soundType;
  doc["alert_type"] = alertType;
  doc["status"]     = "unread";

  // Convert single character direction into string format
  String fullDirection = "None";
  if (direction == 'L') fullDirection = "Left";
  else if (direction == 'R') fullDirection = "Right";

  JsonObject metadata = doc.createNestedObject("metadata");
  metadata["direction"] = fullDirection;
  metadata["source"]    = "sonoband_esp32";

  String jsonPayload;
  serializeJson(doc, jsonPayload);

  Serial.printf("[Supabase] Uploading Alert: %s\n", jsonPayload.c_str());

  int httpCode = http.POST(jsonPayload);

  if (httpCode == 201 || httpCode == 200) {
    Serial.printf("[Supabase] Success! Inserted alert into table. Code: %d\n", httpCode);
  } else {
    Serial.printf("[Supabase] Upload Failed! HTTP Code: %d | Response: %s\n", httpCode, http.getString().c_str());
  }

  http.end();
}

// ================= EDGE IMPULSE CALLBACK & INFERENCE =================
int raw_feature_get_data(size_t offset, size_t length, float *out_ptr) {
  for (size_t i = 0; i < length; i++) {
    out_ptr[i] = (float)inferenceBuffer[offset + i];
  }
  return 0;
}

String classifyAudioBufferOnDevice(String &outPriorityClass) {
  signal_t signal;
  signal.total_length = AUDIO_ACCUM_SIZE;
  signal.get_data = &raw_feature_get_data;

  ei_impulse_result_t result = { 0 };

  // Explicit heap check before running TFLite classifier
  Serial.printf("[SYSTEM] Free Heap before inference: %d Bytes\n", ESP.getFreeHeap());

  EI_IMPULSE_ERROR r = run_classifier(&signal, &result, false);

  if (r != EI_IMPULSE_OK) {
    Serial.printf("[TINYML] Inference failed (Error code: %d)\n", r);
    return "";
  }

  float maxConfidence = 0.0f;
  int topClassIdx = -1;

  Serial.println("\n--- [TINYML INFERENCE SCORES] ---");
  for (size_t ix = 0; ix < EI_CLASSIFIER_LABEL_COUNT; ix++) {
    Serial.printf("  %s: %.2f%%\n", result.classification[ix].label, result.classification[ix].value * 100.0f);
    if (result.classification[ix].value > maxConfidence) {
      maxConfidence = result.classification[ix].value;
      topClassIdx = ix;
    }
  }

  if (topClassIdx >= 0) {
    String detectedLabel = String(result.classification[topClassIdx].label);
    String lowerLabel = detectedLabel;
    lowerLabel.toLowerCase();

    float requiredConfidence = 0.40f;

    if (lowerLabel.indexOf("knock") >= 0 || lowerLabel.indexOf("glass") >= 0 || lowerLabel.indexOf("fallen") >= 0) {
      requiredConfidence = 0.25f;
    } else if (lowerLabel.indexOf("bark") >= 0 || lowerLabel.indexOf("baby") >= 0 || lowerLabel.indexOf("cry") >= 0 || lowerLabel.indexOf("speech") >= 0 || lowerLabel.indexOf("doorbell") >= 0 || lowerLabel.indexOf("phone") >= 0) {
      requiredConfidence = 0.30f;
    } else if (lowerLabel.indexOf("siren") >= 0 || lowerLabel.indexOf("alarm") >= 0 || lowerLabel.indexOf("horn") >= 0 || lowerLabel.indexOf("fire") >= 0) {
      requiredConfidence = 0.35f;
    }

    // Check if the prediction meets the threshold
    if (maxConfidence >= requiredConfidence) {
      if (detectedLabel != "noise" && detectedLabel != "background" && detectedLabel != "z_noise" && detectedLabel != "unknown") {
        Serial.printf("[TINYML] Verified Sound: %s (Confidence: %.2f%% | Required: %.2f%%)\n", 
                      detectedLabel.c_str(), maxConfidence * 100.0f, requiredConfidence * 100.0f);

        if (lowerLabel.indexOf("fire") >= 0 || lowerLabel.indexOf("siren") >= 0 || lowerLabel.indexOf("fallen") >= 0) {
          outPriorityClass = "critical";
        } else if (lowerLabel.indexOf("glass") >= 0 || lowerLabel.indexOf("baby") >= 0 || lowerLabel.indexOf("cry") >= 0 || lowerLabel.indexOf("horn") >= 0 || lowerLabel.indexOf("car") >= 0 || lowerLabel.indexOf("bark") >= 0 || lowerLabel.indexOf("dog") >= 0) {
          outPriorityClass = "high";
        } else if (lowerLabel.indexOf("doorbell") >= 0 || lowerLabel.indexOf("bell") >= 0 || lowerLabel.indexOf("clock") >= 0) {
          outPriorityClass = "medium";
        } else {
          outPriorityClass = "low";
        }

        return detectedLabel;
      }
    }
  }

  Serial.printf("[TINYML] Below adaptive confidence threshold (Highest: %.2f%%)\n", maxConfidence * 100.0f);
  return "";
}

// ================= FREERTOS CORE 0 AUDIO SAMPLING TASK =================
void audioTask(void *pvParameters) {
  int localAccumIndex = 0;
  long peakLeft = 0;
  long peakRight = 0;

  for (;;) {
    if (deviceOn) {
      size_t bytesRead = 0;
      i2s_read(I2S_PORT, &i2sRawBuffer, sizeof(i2sRawBuffer), &bytesRead, portMAX_DELAY);

      int samplesRead = bytesRead / 4;

      for (int i = 0; i < samplesRead; i += 2) {
        int16_t leftSample  = (int16_t)(((i2sRawBuffer[i] >> 14)) * micLeftGain);
        int16_t rightSample = (int16_t)(((i2sRawBuffer[i + 1] >> 14)) * micRightGain);

        long absLeft = abs(leftSample);
        long absRight = abs(rightSample);

        if (absLeft > peakLeft) peakLeft = absLeft;
        if (absRight > peakRight) peakRight = absRight;

        if (localAccumIndex < AUDIO_ACCUM_SIZE) {
          monoSendBuffer[localAccumIndex++] = (int16_t)((leftSample + rightSample) / 2);
        }
      }

      if (localAccumIndex >= AUDIO_ACCUM_SIZE) {
        long sumEnergy = 0;
        for (int k = 0; k < AUDIO_ACCUM_SIZE; k += 16) {
          int32_t val = monoSendBuffer[k];
          sumEnergy += (val * val) / 1000;
        }
        long avgEnergy = sumEnergy / (AUDIO_ACCUM_SIZE / 16);

        AudioFrameMeta meta;
        meta.peakLeft = peakLeft;
        meta.peakRight = peakRight;
        meta.avgEnergy = avgEnergy;

        xQueueOverwrite(audioQueue, &meta);

        localAccumIndex = 0;
        peakLeft = 0;
        peakRight = 0;

        i2s_zero_dma_buffer(I2S_PORT);
      }
    } else {
      localAccumIndex = 0;
      peakLeft = 0;
      peakRight = 0;
      vTaskDelay(100 / portTICK_PERIOD_MS);
    }
  }
}

