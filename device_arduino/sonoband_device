}

void updateFullDisplay(String label, char dir) {
  if (label == lastRenderedLabel && dir == lastRenderedDir) return;
  
  lastRenderedLabel = label;
  lastRenderedDir = dir;

  uint16_t bgColor;
  if (dir == 'L') bgColor = COLOR_PURE_RED;         
  else if (dir == 'R') bgColor = COLOR_PURE_BLUE;     
  else bgColor = COLOR_DARK_BG;       

  tft.fillScreen(bgColor);

  const unsigned char* selectedIcon = epd_bitmap_ic_wave; 
  String lowerLabel = label;
  lowerLabel.toLowerCase();

  if (lowerLabel.indexOf("siren") >= 0 || lowerLabel.indexOf("fire") >= 0 || lowerLabel.indexOf("alarm") >= 0) {
    selectedIcon = epd_bitmap_ic_siren;
  } else if (lowerLabel.indexOf("bark") >= 0 || lowerLabel.indexOf("dog") >= 0) {
    selectedIcon = epd_bitmap_ic_barking;
  } else if (lowerLabel.indexOf("doorbell") >= 0 || lowerLabel.indexOf("bell") >= 0 || lowerLabel.indexOf("knock") >= 0) {
    selectedIcon = epd_bitmap_ic_doorbell;
  } else if (lowerLabel.indexOf("baby") >= 0 || lowerLabel.indexOf("cry") >= 0) {
    selectedIcon = epd_bitmap_ic_baby;
  } else if (lowerLabel.indexOf("car") >= 0 || lowerLabel.indexOf("horn") >= 0 || lowerLabel.indexOf("traffic") >= 0) {
    selectedIcon = epd_bitmap_ic_car;
  } else if (lowerLabel.indexOf("speech") >= 0 || lowerLabel.indexOf("talk") >= 0 || lowerLabel.indexOf("voice") >= 0) {
    selectedIcon = epd_bitmap_ic_speech;
  } else if (lowerLabel.indexOf("glass") >= 0 || lowerLabel.indexOf("fallen") >= 0 || lowerLabel.indexOf("object") >= 0 || lowerLabel.indexOf("phone") >= 0) {
    selectedIcon = epd_bitmap_ic_alert;
  }

  tft.drawBitmap(8, 40, selectedIcon, 32, 32, ST7735_WHITE);

  tft.setTextColor(ST7735_WHITE);
  if (label.length() <= 13) {
    tft.setTextSize(2); 
    int xPos = (160 - (label.length() * 12)) / 2;
    tft.setCursor(xPos < 2 ? 2 : xPos, 8);
  } else {
    tft.setTextSize(1); 
    int xPos = (160 - (label.length() * 6)) / 2;
    tft.setCursor(xPos < 2 ? 2 : xPos, 12);
  }
  tft.print(label);

  tft.setTextSize(2); 
  if (dir == 'L') {
    tft.setCursor(48, 48);  
    tft.print("<- Left");
  } else if (dir == 'R') {
    tft.setCursor(44, 48);
    tft.print("Right ->");
  } else {  
    tft.setTextSize(1);
    tft.setCursor(40, 52);  
    tft.print("[ Ready to Detect ]"); 
  }
}