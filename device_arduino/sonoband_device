void drawWaitingForAppScreen() {
  if (lastRenderedLabel == "WAITING_FOR_APP") return;
  
  tft.fillScreen(ST7735_BLACK);
  tft.setTextColor(ST7735_CYAN);
  tft.setTextSize(1);
  tft.setCursor(10, 15);
  tft.print("Status: Waiting for App");

  tft.setTextColor(ST7735_WHITE);
  tft.setCursor(10, 35);
  tft.print("IP: ");
  tft.print(WiFi.localIP().toString());

  tft.setTextColor(ST7735_YELLOW);
  tft.setCursor(10, 55);
  tft.print("Open app to pair");

  lastRenderedLabel = "WAITING_FOR_APP";
  lastRenderedDir = '\0';
}

