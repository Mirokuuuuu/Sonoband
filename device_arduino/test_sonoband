#define COLOR_PURE_RED   0x001F  // Renders Vibrant RED on ST7735
#define COLOR_PURE_BLUE  0xF800  // Renders Vibrant BLUE on ST7735
#define COLOR_DARK_BG    0x2945

// ================= USER WI-FI SETTINGS =================
const char* ssid     = "Connect ka? Wag na!";     
const char* password = "136722100143123";          

// ================= NETWORK & UDP / HTTP SETTINGS =================
IPAddress appIP;                                
bool appIPKnown = false;
const int udpPort = 8888;                          
WiFiUDP udp;

WebServer httpServer(5000); 

unsigned long lastAnnounce = 0;
const unsigned long ANNOUNCE_INTERVAL = 3000; // Heartbeat sent every 3s
unsigned long lastWifiCheck = 0;

// ================= PIN DEFINITIONS =================
