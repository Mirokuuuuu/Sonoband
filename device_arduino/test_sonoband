#define TFT_DC   27
#define TFT_RST  4
#define TFT_SCLK 23  
#define TFT_MOSI 18  

Adafruit_ST7735 tft = Adafruit_ST7735(TFT_CS, TFT_DC, TFT_RST);

#define VIB_MOTOR_PIN 32 

// I2S Pins for INMP441 Dual Microphones
#define I2S_WS   25  // Word Select
