#define I2S_SD   34  // Data In

#define I2S_PORT I2S_NUM_0
#define SAMPLE_RATE 16000
#define I2S_BUFFER_LEN 512

int32_t i2sRawBuffer[I2S_BUFFER_LEN];

// Audio chunking for ML classification
#define AUDIO_ACCUM_SIZE 4096
int16_t monoSendBuffer[AUDIO_ACCUM_SIZE];
int accumIndex = 0;

// ================= STATE VARIABLES =================
bool deviceOn = true;            
bool isConnectedToApp = false; // Starts false until app/wifi syncs

unsigned long lastHeartbeat = 0;   
const unsigned long HEARTBEAT_TIMEOUT = 45000; 

int noiseFloor = 1200;            
String currentLoggedInUser = "21"; // Default fallback user ID
int vibrationPwmValue = 165;     

String activeSoundType = "Listening..."; 
String currentDisplayLabel = "Ready to Detect";
char currentDirectionChar = 'N'; 

unsigned long lastAlertTime = 0;
const unsigned long alertCooldown = 2000; 
unsigned long displayResetTime = 0;
unsigned long vibOffTime = 0;
bool isVibrating = false;

String lastRenderedLabel = "";
char lastRenderedDir = '\0';

// Helper to get subnet broadcast address
IPAddress getBroadcastIP() {
  if (WiFi.status() != WL_CONNECTED) return IPAddress(255, 255, 255, 255);
  IPAddress localIP = WiFi.localIP();
  IPAddress netMask = WiFi.subnetMask();
  IPAddress broadcast;
  for (int i = 0; i < 4; i++) {
    broadcast[i] = localIP[i] | (~netMask[i]);
  }
  return broadcast;
}

// Non-blocking WiFi reconnect trigger
void checkWifiConnection() {
  if (WiFi.status() != WL_CONNECTED) {
    Serial.println("[Wi-Fi] Disconnected / Searching for network...");
    WiFi.reconnect();
  }
}

// ================= FUNCTION PROTOTYPES =================
void setupI2S();
void setupHttpEndpoints();
void updateFullDisplay(String label, char dir);
void drawWelcomeScreen();
void drawOffScreen();
void sendWifiAlert(String direction, long amplitude, int16_t* rawBuffer, int bufferLength);
void sendHandshakeResponse();
void triggerVibration(int pwm, unsigned long durationMs = 200);
void updateVibration();
void applyCORS();

void setup() {
  Serial.begin(115200);
  delay(500); 
  Serial.println("\n=== SONOBAND ESP32 INITIALIZING ===");

  pinMode(VIB_MOTOR_PIN, OUTPUT);
  analogWrite(VIB_MOTOR_PIN, 0);

  // 1. Initialize Screen
  SPI.begin(TFT_SCLK, -1, TFT_MOSI, TFT_CS);
  tft.initR(INITR_MINI160x80); 
  tft.invertDisplay(false); 
  tft.setRotation(1);          

  drawWelcomeScreen();
  delay(1000);

  // 2. Initialize Dual-Mic I2S Hardware Driver (Sound detection starts HERE)
  setupI2S();

  // 3. Start Wi-Fi asynchronously in background (Non-blocking)
  WiFi.mode(WIFI_STA);
  WiFi.setAutoReconnect(true);
  WiFi.setSleep(false); 
  WiFi.begin(ssid, password);
  Serial.println("[Wi-Fi] Non-blocking connection initiated...");

  udp.begin(udpPort);
  setupHttpEndpoints();
  httpServer.begin();

  lastHeartbeat = millis(); 
  deviceOn = true;

  // Jump straight to detection readiness
  updateFullDisplay("Ready to Detect", 'N');
}

void setupI2S() {
  i2s_config_t i2s_config = {
    .mode = (i2s_mode_t)(I2S_MODE_MASTER | I2S_MODE_RX),
    .sample_rate = SAMPLE_RATE,
    .bits_per_sample = I2S_BITS_PER_SAMPLE_32BIT,
    .channel_format = I2S_CHANNEL_FMT_RIGHT_LEFT,
    .communication_format = I2S_COMM_FORMAT_STAND_I2S,
    .intr_alloc_flags = ESP_INTR_FLAG_LEVEL1,
    .dma_buf_count = 4,
    .dma_buf_len = 256,
    .use_apll = false,
    .tx_desc_auto_clear = false,
    .fixed_mclk = 0
  };

  i2s_pin_config_t pin_config = {
    .bck_io_num = I2S_SCK,
    .ws_io_num = I2S_WS,
    .data_out_num = I2S_PIN_NO_CHANGE,
    .data_in_num = I2S_SD
  };

  i2s_driver_install(I2S_PORT, &i2s_config, 0, NULL);
  i2s_set_pin(I2S_PORT, &pin_config);
  i2s_zero_dma_buffer(I2S_PORT);
  Serial.println("[I2S] Dual-Mic Stereo Driver Initialized.");
}

void applyCORS() {
  httpServer.sendHeader("Access-Control-Allow-Origin", "*");
  httpServer.sendHeader("Access-Control-Allow-Methods", "POST, GET, OPTIONS");
  httpServer.sendHeader("Access-Control-Allow-Headers", "Content-Type");
}

// ================= HTTP HANDLERS =================
void setupHttpEndpoints() {
  httpServer.on("/connect", HTTP_OPTIONS, []() { applyCORS(); httpServer.send(204); });
  httpServer.on("/disconnect", HTTP_OPTIONS, []() { applyCORS(); httpServer.send(204); });
  httpServer.on("/config", HTTP_OPTIONS, []() { applyCORS(); httpServer.send(204); });
  httpServer.on("/ping", HTTP_OPTIONS, []() { applyCORS(); httpServer.send(204); });

  httpServer.on("/ping", HTTP_GET, []() {
    applyCORS();
    lastHeartbeat = millis();
    String response = "{\"status\":\"alive\",\"device\":\"sonoband\",\"is_connected\":" + String(isConnectedToApp ? "true" : "false") + ",\"is_on\":" + String(deviceOn ? "true" : "false") + "}";
    httpServer.send(200, "application/json", response);
  });

  httpServer.on("/connect", HTTP_POST, []() {
    appIP = httpServer.client().remoteIP();
    appIPKnown = true;
    isConnectedToApp = true; 
    deviceOn = true; 
    lastHeartbeat = millis();

    updateFullDisplay("Ready to Detect", 'N'); 
    triggerVibration(100, 200);

    applyCORS();
    httpServer.send(200, "application/json", "{\"status\":\"success\",\"message\":\"Connected & Active\",\"ip\":\"" + WiFi.localIP().toString() + "\"}");
  });

  httpServer.on("/disconnect", HTTP_POST, []() {
    appIPKnown = false;
    isConnectedToApp = false;
    applyCORS();
    httpServer.send(200, "application/json", "{\"status\":\"success\",\"message\":\"Disconnected from app\"}");
  });

  httpServer.on("/config", HTTP_POST, []() {
    appIP = httpServer.client().remoteIP();
    appIPKnown = true;
    lastHeartbeat = millis();
    
    if (httpServer.hasArg("plain")) {
      String body = httpServer.arg("plain");
      #if ARDUINOJSON_VERSION_MAJOR >= 7
        JsonDocument doc;
      #else
        DynamicJsonDocument doc(2048);
      #endif
      DeserializationError err = deserializeJson(doc, body);
      if (!err) {
        if (doc.containsKey("user_id")) {
          if (doc["user_id"].is<int>()) {
            currentLoggedInUser = String(doc["user_id"].as<int>());
          } else {
            String uid = doc["user_id"].as<String>();
            if (uid.length() > 0) currentLoggedInUser = uid;
          }
        }

        if (doc.containsKey("is_on")) {
          deviceOn = doc["is_on"].as<bool>();
        } else if (doc.containsKey("power")) {
          String pwr = doc["power"].as<String>();
          deviceOn = (pwr == "on" || pwr == "true");
        }

        if (!deviceOn) {
          drawOffScreen(); 
        } else {
          activeSoundType = "Listening...";
          currentDisplayLabel = "Ready to Detect";
          updateFullDisplay(currentDisplayLabel, 'N'); 
        }

        if (doc.containsKey("vibration_intensity")) {
          String vib = doc["vibration_intensity"].as<String>();
          if (vib == "low") vibrationPwmValue = 80;
          else if (vib == "high") vibrationPwmValue = 255;
          else vibrationPwmValue = 165;
        }
        if (doc.containsKey("sensitivity") || doc.containsKey("sound_threshold")) {
          String sens = doc.containsKey("sensitivity") ? doc["sensitivity"].as<String>() : doc["sound_threshold"].as<String>();
          noiseFloor = (sens == "broad" || sens == "wide") ? 800 : 1500;
        }
      }
    }
    applyCORS();
    httpServer.send(200, "application/json", "{\"status\":\"success\",\"config\":\"updated\",\"is_on\":" + String(deviceOn ? "true" : "false") + "}");
  });
}

// ================= MAIN LOOP =================
void loop() {
  // Non-blocking WiFi reconnect check every 10 seconds
  if (millis() - lastWifiCheck > 10000) {
    checkWifiConnection();
    lastWifiCheck = millis();
  }

  // Handle server clients safely if connected
  if (WiFi.status() == WL_CONNECTED) {
    httpServer.handleClient();
  }
  
  updateVibration();

  // 1. LISTEN FOR CLASSIFICATION RESPONSES VIA UDP (If connected)
  if (WiFi.status() == WL_CONNECTED) {
    int packetSize = udp.parsePacket();
    if (packetSize > 0) {
      char incoming[512];
      int len = udp.read(incoming, 511);
      if (len > 0) incoming[len] = 0;

      #if ARDUINOJSON_VERSION_MAJOR >= 7
        JsonDocument doc;
      #else
        DynamicJsonDocument doc(512);
      #endif
      DeserializationError error = deserializeJson(doc, incoming);

      if (!error) {
        lastHeartbeat = millis();

        if (doc.containsKey("detected_sound") && deviceOn) {
          String label = doc["detected_sound"].as<String>();
          
          if (doc.containsKey("direction")) {
            String dirStr = doc["direction"].as<String>();
            if (dirStr == "left") currentDirectionChar = 'L';
            else if (dirStr == "right") currentDirectionChar = 'R';
          }

          if (label != "none" && label != "unknown" && label != "Standby") {
            activeSoundType = label;
            currentDisplayLabel = label;
            updateFullDisplay(currentDisplayLabel, currentDirectionChar);
            displayResetTime = millis();
            triggerVibration(vibrationPwmValue, 300);
          }
        }
      }
    }
  }

  // 2. Periodic Handshake Pong (If connected)
  if (millis() - lastAnnounce > ANNOUNCE_INTERVAL) {
    sendHandshakeResponse();
    lastAnnounce = millis();
  }

  // 3. STEREO I2S SAMPLING & SOUND ALERT DISPATCH
  if (deviceOn) { 
    if (currentDisplayLabel != "Ready to Detect" && (millis() - displayResetTime > alertCooldown)) {
      currentDisplayLabel = "Ready to Detect";
      currentDirectionChar = 'N'; 
      activeSoundType = "Listening..."; 
      updateFullDisplay(currentDisplayLabel, currentDirectionChar);
    }

    if (millis() - lastAlertTime < alertCooldown) return; 

    size_t bytesRead = 0;
    // Reads I2S audio without blocking the hardware loop
    i2s_read(I2S_PORT, &i2sRawBuffer, sizeof(i2sRawBuffer), &bytesRead, portMAX_DELAY);

    int samplesRead = bytesRead / 4;
    long peakAmpLeft = 0;
    long peakAmpRight = 0;

    for (int i = 0; i < samplesRead; i += 2) {
      int32_t leftSample = (i2sRawBuffer[i] >> 14);
      int32_t rightSample = (i2sRawBuffer[i + 1] >> 14);

      long absLeft = abs(leftSample);
      long absRight = abs(rightSample);

      if (absLeft > peakAmpLeft) peakAmpLeft = absLeft;
      if (absRight > peakAmpRight) peakAmpRight = absRight;

      if (accumIndex < AUDIO_ACCUM_SIZE) {
        monoSendBuffer[accumIndex++] = (int16_t)((leftSample + rightSample) / 2);
      }
    }

    long maxPeak = max(peakAmpLeft, peakAmpRight);

    // Sound detected above threshold - IMMEDIATE local alert trigger
    if (maxPeak >= noiseFloor && accumIndex >= AUDIO_ACCUM_SIZE) {
      String winningDirection = (peakAmpRight > peakAmpLeft) ? "right" : "left";
      char newDirectionChar = (peakAmpRight > peakAmpLeft) ? 'R' : 'L';

      currentDisplayLabel = "Loud Sound!";
      currentDirectionChar = newDirectionChar;
      
      // Update screen immediately
      updateFullDisplay(currentDisplayLabel, currentDirectionChar);
      
      // Trigger motor feedback immediately
      triggerVibration(vibrationPwmValue, 250);

      displayResetTime = millis();
      lastAlertTime = millis(); 

      // Send network alert ONLY if Wi-Fi is available (Non-blocking)
      sendWifiAlert(winningDirection, maxPeak, monoSendBuffer, AUDIO_ACCUM_SIZE);
      
      accumIndex = 0; 
    } else if (accumIndex >= AUDIO_ACCUM_SIZE) {
      accumIndex = 0; 
    }
  } else {
    drawOffScreen();
  }
}

// ================= NETWORK HELPERS =================
void sendHandshakeResponse() {
  if (WiFi.status() == WL_CONNECTED) {
    IPAddress target = appIPKnown ? appIP : getBroadcastIP();
    udp.beginPacket(target, udpPort);
    String payload = "{\"type\":\"pong\",\"device\":\"sonoband\",\"status\":\"active\",\"is_connected\":" + 
                     String(isConnectedToApp ? "true" : "false") + ",\"is_on\":" + 
                     String(deviceOn ? "true" : "false") + ",\"mac_address\":\"" + 
                     WiFi.macAddress() + "\",\"ip_address\":\"" + WiFi.localIP().toString() + "\"}";
    udp.print(payload);
    udp.endPacket();
  }
}

void sendWifiAlert(String direction, long amplitude, int16_t* rawBuffer, int bufferLength) {
  if (WiFi.status() == WL_CONNECTED && deviceOn) {
    IPAddress target = appIPKnown ? appIP : getBroadcastIP();
    
    #if ARDUINOJSON_VERSION_MAJOR >= 7
      JsonDocument doc;
    #else
      DynamicJsonDocument doc(512);
    #endif

    doc["type"] = "alert";
    doc["user_id"] = currentLoggedInUser;
    doc["mac_address"] = WiFi.macAddress();
    doc["ip_address"] = WiFi.localIP().toString();
    doc["direction"] = direction;
    doc["amplitude"] = amplitude;
    doc["sound_type"] = "Loud Sound"; 

    udp.beginPacket(target, udpPort);
    serializeJson(doc, udp);
    udp.endPacket();
  }
}

// ================= HARDWARE CONTROLS & DISPLAY =================
void triggerVibration(int pwm, unsigned long durationMs) {
  analogWrite(VIB_MOTOR_PIN, pwm);
  vibOffTime = millis() + durationMs;
  isVibrating = true;
}

void updateVibration() {
  if (isVibrating && millis() >= vibOffTime) {
    analogWrite(VIB_MOTOR_PIN, 0);
    isVibrating = false;
  }
}

void drawWelcomeScreen() {
  tft.fillScreen(ST7735_BLACK);
  tft.setTextColor(ST7735_CYAN);
  tft.setTextSize(2);
  tft.setCursor(35, 15);
  tft.print("WELCOME");
  tft.setCursor(32, 45);
  tft.setTextColor(ST7735_WHITE);
  tft.print("SonoBand");
  lastRenderedLabel = "";
  lastRenderedDir = '\0';
}

void drawOffScreen() {
  if (lastRenderedLabel == "POWER OFF") return;
  tft.fillScreen(ST7735_BLACK);
  tft.setTextColor(ST7735_WHITE);
  tft.setTextSize(2);
  tft.setCursor(28, 30);
  tft.print("POWER OFF");
  lastRenderedLabel = "POWER OFF";
  lastRenderedDir = '\0';
}

void updateFullDisplay(String label, char dir) {
  if (label == lastRenderedLabel && dir == lastRenderedDir) return;
  
  lastRenderedLabel = label;
  lastRenderedDir = dir;

  uint16_t bgColor;
  if (dir == 'L') bgColor = COLOR_PURE_RED;         
  else if (dir == 'R') bgColor = COLOR_PURE_BLUE;     
  else bgColor = COLOR_DARK_BG;       

  tft.fillScreen(bgColor);

  const unsigned char* selectedIcon = epd_bitmap_ic_wave; 
  String lowerLabel = label;
  lowerLabel.toLowerCase();

  if (lowerLabel.indexOf("siren") >= 0 || lowerLabel.indexOf("alarm") >= 0) {
    selectedIcon = epd_bitmap_ic_siren;
  } else if (lowerLabel.indexOf("bark") >= 0 || lowerLabel.indexOf("dog") >= 0) {
    selectedIcon = epd_bitmap_ic_barking;
  } else if (lowerLabel.indexOf("bell") >= 0 || lowerLabel.indexOf("door") >= 0 || lowerLabel.indexOf("knock") >= 0) {
    selectedIcon = epd_bitmap_ic_doorbell;
  } else if (lowerLabel.indexOf("baby") >= 0 || lowerLabel.indexOf("cry") >= 0) {
    selectedIcon = epd_bitmap_ic_baby;
  } else if (lowerLabel.indexOf("car") >= 0 || lowerLabel.indexOf("horn") >= 0 || lowerLabel.indexOf("traffic") >= 0) {
    selectedIcon = epd_bitmap_ic_car;
  } else if (lowerLabel.indexOf("speech") >= 0 || lowerLabel.indexOf("talk") >= 0 || lowerLabel.indexOf("voice") >= 0 || lowerLabel.indexOf("calling") >= 0) {
    selectedIcon = epd_bitmap_ic_speech;
  } else if (lowerLabel.indexOf("alert") >= 0 || lowerLabel.indexOf("loud") >= 0) {
    selectedIcon = epd_bitmap_ic_alert;
  }

  tft.drawBitmap(8, 40, selectedIcon, 32, 32, ST7735_WHITE);

  tft.setTextColor(ST7735_WHITE);
  if (label.length() <= 13) {
    tft.setTextSize(2); 
    int xPos = (160 - (label.length() * 12)) / 2;
    tft.setCursor(xPos < 2 ? 2 : xPos, 8);
  } else {
    tft.setTextSize(1); 
    int xPos = (160 - (label.length() * 6)) / 2;
    tft.setCursor(xPos < 2 ? 2 : xPos, 12);
  }
  tft.print(label);

  tft.setTextSize(2); 
  if (dir == 'L') {
    tft.setCursor(48, 48);
    tft.print("<- LEFT");
  } else if (dir == 'R') {
    tft.setCursor(44, 48);
    tft.print("RIGHT ->");
  } else {  
    tft.setTextSize(1);
    tft.setCursor(40, 52);  
    tft.print("[ Ready to Detect ]");
  }
}